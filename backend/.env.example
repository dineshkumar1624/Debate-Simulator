# ==============================================================================
# AI Debate Simulator - Backend Environment Variables
# ==============================================================================

# Relational Database (PostgreSQL with SQLite fallback)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_debate_simulator

# Qdrant Vector Store
# Leave QDRANT_URL empty to use local embedded persistence at QDRANT_STORAGE_PATH
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_STORAGE_PATH=./qdrant_data
QDRANT_COLLECTION_NAME=debate_knowledge

# Sentence Transformers Embedding Configuration
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ==============================================================================
# EXACT THREE STANDARDIZED MODELS CONFIGURATION
# ==============================================================================

# MODEL 1: PRO AGENT (Google Gemma 4 E4B Instruct Q4_0 GGUF via llama.cpp)
GEMMA_MODEL_PATH=D:/models/gemma-4-E4B-Q4/gemma-4-E4B_q4_0-it.gguf
GEMMA_BASE_URL=http://127.0.0.1:8081/v1
GEMMA_MODEL_NAME=gemma-4-E4B-Q4_0
GEMMA_TIMEOUT_SECONDS=120.0
GEMMA_AUTOSTART_SERVER=true
PRO_MODEL_PATH=D:/models/gemma-4-E4B-Q4/gemma-4-E4B_q4_0-it.gguf
PRO_MAX_NEW_TOKENS=256
LLAMA_CONTEXT_SIZE=3072

# MODEL 2: CON AGENT (Alibaba Qwen2.5-VL-7B-Instruct Q4_K_M GGUF via llama.cpp)
QWEN_MODEL_PATH=D:/models/Qwen2.5-VL-7B-Instruct
QWEN_GGUF_PATH=D:/models/qwen-2.5-VL-7B-Q4/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
QWEN_MMPROJ_PATH=D:/models/qwen-2.5-VL-7B-Q4/mmproj-Qwen2.5-VL-7B-Instruct-Q8_0.gguf
QWEN_MODEL_NAME=Qwen2.5-VL-7B-Instruct
QWEN_BASE_URL=http://127.0.0.1:8083/v1
QWEN_PORT=8083
QWEN_AUTOSTART_SERVER=true
QWEN_TIMEOUT_SECONDS=120.0
CON_MODEL_PATH=D:/models/Qwen2.5-VL-7B-Instruct
CON_MAX_NEW_TOKENS=128

# Hybrid Dual-Server Memory Management
DUAL_SERVER_MIN_MEMORY_GB=1.0
CRITICAL_MEMORY_ABORT_GB=0.5
SEQUENTIAL_SWAP_IF_LOW_RAM=true

# MODEL 3: JUDGE AGENT PROVIDERS (Google Gemini & NVIDIA NIM)
JUDGE_PROVIDER=gemini

# Google Gemini API Configuration (JUDGE Model)
# Generate your API key in Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL_ID=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=120
GEMINI_MAX_RETRIES=2

# NVIDIA NIM API Configuration (Alternative JUDGE Model)
# Generate your API key in NVIDIA NGC / Build: https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_JUDGE_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_TIMEOUT_SECONDS=180
NVIDIA_MAX_RETRIES=2

# Web Search Provider for General Topics (Mode D)
# Options: duckduckgo | tavily | serpapi | mock
SEARCH_PROVIDER=duckduckgo
SEARCH_API_KEY=

# Inference Device Configuration
# Options: cpu (default for CPU-only dev machines) | cuda | auto
INFERENCE_DEVICE=cpu

# Server Configuration
PORT=8000
HOST=0.0.0.0

