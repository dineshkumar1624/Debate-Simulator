# =============================================================================
# Git Ignore - AI Debate Simulator (Full-Stack Multi-Agent AI Application)
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment Variables & Credentials (Security & Secrets)
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
backend/.env
backend/.env.*
frontend/.env
frontend/.env.*
!.env.example
!**/.env.example

# -----------------------------------------------------------------------------
# 2. SQLite Databases, Transaction Journals & Backups
# -----------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.db-journal
**/*.db
**/*.db-shm
**/*.db-wal
**/*.db-journal
*.sqlite
*.sqlite3
**/*.sqlite
**/*.sqlite3
*.backup
*.backup*
**/*.backup
**/*.backup*
*.bak
*.bak*
**/*.bak*
*.old
*.orig
**/*.old
**/*.orig
*.patch
debate_simulator.db*
**/debate_simulator.db*
backend/debate_simulator.db*

# -----------------------------------------------------------------------------
# 3. Vector Database Storage (Qdrant Embedded, Segment Data & Lock Files)
# -----------------------------------------------------------------------------
qdrant_data/
**/qdrant_data/
backend/qdrant_data/
storage.lock
*.lock
!package-lock.json
!frontend/package-lock.json

# -----------------------------------------------------------------------------
# 4. User Uploaded Documents & Media (Keep directory structure with .gitkeep)
# -----------------------------------------------------------------------------
uploaded_documents/*
**/uploaded_documents/*
backend/uploaded_documents/*
!uploaded_documents/.gitkeep
!**/uploaded_documents/.gitkeep
!backend/uploaded_documents/.gitkeep

# -----------------------------------------------------------------------------
# 5. Large AI Model Weights & Checkpoints (GGUF, safetensors, ONNX, PyTorch)
# -----------------------------------------------------------------------------
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.safetensors
/models/
**/models_cpu_converted/
/models_cpu_converted/
!backend/app/models/

# -----------------------------------------------------------------------------
# 6. Backend: Python Caches, Virtual Environments & Packaging
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
backend/.venv/
**/venv/
**/.venv/
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

