# =============================================================================
# Git Ignore - AI Debate Simulator
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Environment Variables & Secrets (Prevent credential leakage)
# -----------------------------------------------------------------------------
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
**/.env
**/.env.*
!.env.example
!**/.env.example

# -----------------------------------------------------------------------------
# 2. SQLite Databases & Transaction Journals
# -----------------------------------------------------------------------------
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.backup
*.backup*
*.bak
*.bak*
*.old
*.orig
debate_simulator.db*
**/debate_simulator.db*

# -----------------------------------------------------------------------------
# 3. Vector Database Storage (Embedded Qdrant & Lock Files)
# -----------------------------------------------------------------------------
qdrant_data/
**/qdrant_data/
storage.lock
*.lock

# -----------------------------------------------------------------------------
# 4. User Uploaded Documents & Media (Keep directory structure with .gitkeep)
# -----------------------------------------------------------------------------
uploaded_documents/*
**/uploaded_documents/*
!uploaded_documents/.gitkeep
!**/uploaded_documents/.gitkeep

# -----------------------------------------------------------------------------
# 5. Large AI Model Weights & Quantized Checkpoints (GGUF, safetensors, etc.)
# -----------------------------------------------------------------------------
*.gguf
*.bin
*.pt
*.pth
*.onnx
*.safetensors
/models/
/models_cpu_converted/
!backend/app/models/

# -----------------------------------------------------------------------------
# 6. Python Caches, Virtual Environments & Build Artifacts
# -----------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
/build/
develop-eggs/
/dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!frontend/src/lib/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Coverage Caches
.pytest_cache/
**/pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.mypy_cache/
.ruff_cache/

# -----------------------------------------------------------------------------
# 7. Node / Frontend Dependencies & Build Outputs
# -----------------------------------------------------------------------------
node_modules/
**/node_modules/
frontend/dist/
dist/
dist-ssr/
*.tsbuildinfo
.eslintcache

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# 8. Temporary Workspaces, Test Reports & Archive Folders
# -----------------------------------------------------------------------------
scratch/
archive/
test_reports/
tmp/
temp/
*.tmp
*.temp

# -----------------------------------------------------------------------------
# 9. IDE & Editor Configuration
# -----------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# 10. Operating System Files
# -----------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/
